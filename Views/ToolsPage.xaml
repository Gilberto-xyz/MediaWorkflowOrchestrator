<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="MediaWorkflowOrchestrator.Views.ToolsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:MediaWorkflowOrchestrator.Models"
    mc:Ignorable="d">
    <Grid x:Name="ToolsLayoutRoot" Padding="{StaticResource PagePaddingDefault}">
        <ScrollViewer
            HorizontalScrollMode="Disabled"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Visible"
            VerticalScrollMode="Auto">
            <StackPanel Spacing="8">
                <StackPanel Spacing="4">
                    <TextBlock Style="{StaticResource PageHeadlineTextStyle}" Text="Herramientas" />
                    <TextBlock
                        Style="{StaticResource SectionDescriptionTextStyle}"
                        Text="Centraliza rutas, defaults y validación para que cada workflow arranque con el entorno correcto." />
                </StackPanel>

                <Border Style="{StaticResource CardContainerStyle}">
                    <StackPanel Spacing="8">
                        <Grid x:Name="ToolsHeaderGrid" ColumnSpacing="12" RowSpacing="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="Rutas y defaults" />
                                <TextBlock
                                    Style="{StaticResource SectionDescriptionTextStyle}"
                                    Text="Rutas de scripts y preferencias para nuevos workflows." />
                            </StackPanel>
                            <Grid Grid.Column="1" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button
                                    Grid.Column="0"
                                    Command="{x:Bind ViewModel.SaveSettingsCommand}"
                                    Content="Guardar"
                                    Style="{StaticResource PrimaryCommandButtonStyle}" />
                                <Button
                                    Grid.Column="1"
                                    Command="{x:Bind ViewModel.RestoreDefaultsCommand}"
                                    Content="Restaurar defaults"
                                    Style="{StaticResource DenseActionButtonStyle}" />
                            </Grid>
                        </Grid>

                        <Border Style="{StaticResource InsetPanelBorderStyle}">
                            <StackPanel Spacing="8">
                                <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="Base del entorno" />
                                <Grid x:Name="ToolsBaseEnvironmentGrid" ColumnSpacing="10" RowSpacing="10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Header="Marca" Text="{x:Bind ViewModel.Settings.BrandName, Mode=TwoWay}" />
                                    <TextBox Grid.Column="1" Header="Python" Text="{x:Bind ViewModel.Settings.PythonPath, Mode=TwoWay}" />
                                </Grid>
                                <Grid x:Name="ToolsScriptPathsGrid" ColumnSpacing="10" RowSpacing="8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Row="0" Grid.Column="0" Header="Script Nyaa" Text="{x:Bind ViewModel.Settings.DownloaderScriptPath, Mode=TwoWay}" />
                                    <TextBox Grid.Row="0" Grid.Column="1" Header="Script Nyaa por link" Text="{x:Bind ViewModel.Settings.DownloaderLinkScriptPath, Mode=TwoWay}" />
                                    <TextBox Grid.Row="1" Grid.Column="0" Header="Script limpiar tracks" Text="{x:Bind ViewModel.Settings.TrackCleanupScriptPath, Mode=TwoWay}" />
                                    <TextBox Grid.Row="1" Grid.Column="1" Header="Script etiquetas" Text="{x:Bind ViewModel.Settings.TagAndRenameScriptPath, Mode=TwoWay}" />
                                    <TextBox Grid.Row="2" Grid.Column="0" Header="Script RAR" Text="{x:Bind ViewModel.Settings.RarPackagingScriptPath, Mode=TwoWay}" />
                                </Grid>
                                <Grid x:Name="ToolsBinaryPathsGrid" ColumnSpacing="10" RowSpacing="10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Header="mkvmerge" Text="{x:Bind ViewModel.Settings.MkvmergePath, Mode=TwoWay}" />
                                    <TextBox Grid.Column="1" Header="rar.exe" Text="{x:Bind ViewModel.Settings.RarExePath, Mode=TwoWay}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource InsetPanelBorderStyle}">
                            <StackPanel Spacing="8">
                                <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="Descarga y procesamiento" />
                                <CheckBox Content="Descarga en dry-run" IsChecked="{x:Bind ViewModel.Settings.DownloaderDryRun, Mode=TwoWay}" />
                                <CheckBox Content="Forzar latest en Nyaa" IsChecked="{x:Bind ViewModel.Settings.DownloaderForceLatest, Mode=TwoWay}" />
                                <CheckBox Content="Limpiar tracks: eliminar originales después de filtrar" IsChecked="{x:Bind ViewModel.Settings.TrackCleanupDeleteOriginals, Mode=TwoWay}" />
                                <CheckBox Content="Etiquetas: buscar e incrustar cover/poster desde IMDb" IsChecked="{x:Bind ViewModel.Settings.TagAndRenameAttachCover, Mode=TwoWay}" />
                                <Border Style="{StaticResource AccentPanelBorderStyle}">
                                    <StackPanel Spacing="4">
                                        <TextBlock FontWeight="SemiBold" Text="Traducción de subtítulos · Codex" />
                                        <TextBlock
                                            Style="{StaticResource SectionDescriptionTextStyle}"
                                            Text="La traducción ya no depende de Ollama ni de un script local. El dashboard prepara la solicitud para Codex y valida el MKV _es-419 antes de reanudar el workflow."
                                            TextWrapping="WrapWholeWords" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource InsetPanelBorderStyle}">
                            <StackPanel Spacing="8">
                                <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="Empaquetado RAR" />
                                <PasswordBox Password="{x:Bind ViewModel.RarPassword, Mode=TwoWay}" Header="Contraseña RAR" />
                                <Grid x:Name="ToolsRarFlagsGrid" ColumnSpacing="10" RowSpacing="10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0" Content="No generar imágenes" IsChecked="{x:Bind ViewModel.Settings.RarSkipImages, Mode=TwoWay}" />
                                    <CheckBox Grid.Column="1" Content="Solo mostrar info, sin crear RAR" IsChecked="{x:Bind ViewModel.Settings.RarNoCompress, Mode=TwoWay}" />
                                </Grid>
                                <CheckBox Content="Usar modo Comprimir en RAR" IsChecked="{x:Bind ViewModel.Settings.RarUseCompressionNormal, Mode=TwoWay}" />
                                <Grid x:Name="ToolsRarCaptureGrid" ColumnSpacing="10" RowSpacing="10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox
                                        Grid.Column="0"
                                        Header="Máximo de imágenes (opcional)"
                                        PlaceholderText="Ej. 6"
                                        Text="{x:Bind ViewModel.Settings.RarCaptureCount, Mode=TwoWay}" />
                                    <ComboBox Grid.Column="1" Header="Formato de imagen" SelectedItem="{x:Bind ViewModel.Settings.RarImageFormat, Mode=TwoWay}">
                                        <x:String>jpg</x:String>
                                        <x:String>png</x:String>
                                    </ComboBox>
                                </Grid>
                                <CheckBox Content="RAR verbose" IsChecked="{x:Bind ViewModel.Settings.RarVerbose, Mode=TwoWay}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource InsetPanelBorderStyle}" Visibility="Collapsed">
                            <StackPanel Spacing="8">
                                <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="Publicación y enlaces" />
                                <TextBlock Style="{StaticResource SectionDescriptionTextStyle}" Text="Estos son destinos iniciales. Cada serie o película puede guardar después su propia carpeta desde la etapa 06." TextWrapping="WrapWholeWords" />
                                <Grid x:Name="ToolsPublicationAppsGrid" ColumnSpacing="10" RowSpacing="10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Header="File &amp; Image Uploader" Text="{x:Bind ViewModel.Settings.FileUploaderExePath, Mode=TwoWay}" />
                                    <TextBox Grid.Column="1" Header="FileUploader.log" Text="{x:Bind ViewModel.Settings.FileUploaderLogPath, Mode=TwoWay}" />
                                </Grid>
                                <Grid x:Name="ToolsPublicationDestinationsGrid" ColumnSpacing="10" RowSpacing="10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Row="0" Grid.Column="0" Header="Raíz de Google Drive" Text="{x:Bind ViewModel.Settings.PublicationDriveRootUrl, Mode=TwoWay}" />
                                    <TextBox Grid.Row="0" Grid.Column="1" Header="Raíz de MediaFire" Text="{x:Bind ViewModel.Settings.PublicationMediaFireRootUrl, Mode=TwoWay}" />
                                    <TextBox Grid.Row="1" Grid.Column="0" Header="Transfer.it" Text="{x:Bind ViewModel.Settings.PublicationTransferItUrl, Mode=TwoWay}" />
                                    <TextBox Grid.Row="1" Grid.Column="1" Header="el_inmortus_bulklist" Text="{x:Bind ViewModel.Settings.PublicationSheetUrl, Mode=TwoWay}" />
                                </Grid>
                                <TextBox Header="Perfil de cuenta MediaFire actual" PlaceholderText="Ej. 2026-08 o correo abreviado" Text="{x:Bind ViewModel.Settings.MediaFireAccountProfile, Mode=TwoWay}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardContainerStyle}">
                    <StackPanel Spacing="8">
                        <Grid x:Name="ToolsValidationHeaderGrid" ColumnSpacing="12" RowSpacing="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="Validación" />
                                <TextBlock
                                    Style="{StaticResource SectionDescriptionTextStyle}"
                                    Text="Comprueba de una sola pasada que cada binario y script crítico sigue resolviendo bien." />
                            </StackPanel>
                            <Button
                                Grid.Column="1"
                                Command="{x:Bind ViewModel.ValidateAllToolsCommand}"
                                Content="Validar herramientas"
                                Style="{StaticResource PrimaryCommandButtonStyle}" />
                        </Grid>

                        <ListView
                            ItemsSource="{x:Bind ViewModel.ValidationResults, Mode=OneWay}"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            ScrollViewer.HorizontalScrollMode="Disabled"
                            ScrollViewer.VerticalScrollBarVisibility="Disabled"
                            ScrollViewer.VerticalScrollMode="Disabled">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:ToolValidationResult">
                                    <Border Margin="0,0,0,6" Style="{StaticResource InsetPanelBorderStyle}">
                                        <StackPanel Spacing="6">
                                            <TextBlock FontWeight="SemiBold" Text="{x:Bind DisplayName}" />
                                            <TextBlock Style="{StaticResource MutedCaptionTextStyle}" Text="{x:Bind StateDisplay}" />
                                            <TextBlock
                                                Style="{StaticResource SectionDescriptionTextStyle}"
                                                Text="{x:Bind Message}"
                                                TextWrapping="WrapWholeWords" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource AccentPanelBorderStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="Notas operativas" />
                        <TextBlock
                            Style="{StaticResource SectionDescriptionTextStyle}"
                            Text="La V1 no reescribe tus scripts. La app valida rutas, ejecuta procesos y persiste estado por workflow." />
                        <TextBlock
                            Style="{StaticResource SectionDescriptionTextStyle}"
                            Text="Si una dependencia no existe, el paso queda bloqueado y la validación muestra la causa exacta." />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
