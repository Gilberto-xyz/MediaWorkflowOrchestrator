<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="MediaWorkflowOrchestrator.Views.DashboardPage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:MediaWorkflowOrchestrator.Models"
    xmlns:local="using:MediaWorkflowOrchestrator.Views"
    mc:Ignorable="d">
    <Grid x:Name="DashboardLayoutRoot" Padding="{StaticResource PagePaddingDefault}">
        <Grid x:Name="DashboardContentGrid" ColumnSpacing="16" RowSpacing="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="0" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="310" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid x:Name="StepNavigationPane" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Spacing="4" Margin="4,6,4,0">
                    <TextBlock Style="{StaticResource PageHeadlineTextStyle}" Text="Pasos del workflow" />
                    <TextBlock Style="{StaticResource MutedCaptionTextStyle}" Text="Selecciona una etapa para ver sus opciones." />
                </StackPanel>
                <ScrollViewer x:Name="StepNavigationScrollViewer" Grid.Row="1"
                    HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollMode="Auto" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{x:Bind ViewModel.VisibleStepItems, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:WorkflowStepState">
                                <Button Margin="0,0,0,4" Padding="0" BorderThickness="0"
                                    Background="Transparent" HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch" Click="OnStepItemClicked"
                                    AutomationProperties.Name="{x:Bind DisplayName, Mode=OneWay}">
                                    <Border Padding="10,8" MinHeight="64" CornerRadius="6"
                                        Background="{x:Bind RowBackgroundBrush, Mode=OneWay}"
                                        BorderBrush="{x:Bind RowBorderBrush, Mode=OneWay}" BorderThickness="3,0,0,1">
                                        <Grid ColumnSpacing="10" RowSpacing="4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="22" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <SymbolIcon Symbol="{x:Bind StepSymbol, Mode=OneWay}"
                                                Foreground="{x:Bind StatusAccentBrush, Mode=OneWay}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" FontSize="14" FontWeight="SemiBold"
                                                Text="{x:Bind DisplayName, Mode=OneWay}" TextTrimming="CharacterEllipsis"
                                                Foreground="{x:Bind TitleBrush, Mode=OneWay}" />
                                            <TextBlock Grid.Row="1" VerticalAlignment="Center"
                                                Style="{StaticResource MutedCaptionTextStyle}" Text="{x:Bind StepNumber, Mode=OneWay}" />
                                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                                <Ellipse Width="6" Height="6" Fill="{x:Bind StatusAccentBrush, Mode=OneWay}" />
                                                <TextBlock FontSize="12" Text="{x:Bind StatusDisplay, Mode=OneWay}"
                                                    Foreground="{x:Bind StatusAccentBrush, Mode=OneWay}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <Grid x:Name="StepWorkspace" Grid.Column="1" RowSpacing="10" SizeChanged="OnStepWorkspaceSizeChanged">
                <Grid.RowDefinitions>
                    <RowDefinition Height="88" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border Padding="12,6,12,10" BorderBrush="{ThemeResource HairlineBrush}" BorderThickness="0,0,0,1">
                    <Grid RowSpacing="3" ColumnSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="OPCIONES Y DATOS" />
                        <TextBlock Grid.Row="1" FontSize="18" FontWeight="SemiBold"
                            Text="{x:Bind ViewModel.SelectedStepTitle, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Row="2" MaxLines="2" Style="{StaticResource MutedCaptionTextStyle}"
                            Text="{x:Bind ViewModel.SelectedStepDescription, Mode=OneWay}" />
                        <TextBlock Grid.Column="1" Grid.Row="1" VerticalAlignment="Center"
                            Style="{StaticResource MutedCaptionTextStyle}"
                            Text="{x:Bind ViewModel.SelectedStep.FinishedAtDisplay, Mode=OneWay}" />
                    </Grid>
                </Border>

                <ScrollViewer x:Name="StepOptionsScrollViewer" Grid.Row="1" Padding="12,0,12,12" ViewChanged="OnContextViewChanged" LayoutUpdated="OnContextLayoutUpdated"
                    HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollMode="Auto" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="DashboardMainColumn" Spacing="16">
                        <StackPanel x:Name="TranslationDecisionPanel" Spacing="8">
                                                <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="NO SE PUDO CONFIRMAR EL IDIOMA" />
                                                <TextBlock
                                                    MaxWidth="920"
                                                    HorizontalAlignment="Left"
                                                    Style="{StaticResource SectionDescriptionTextStyle}"
                                                    Text="Indica si faltan los subtítulos en español. El flujo quedará detenido hasta que vuelvas de Codex con el MKV traducido." />
                                                <local:ActionWrapPanel x:Name="TranslationDecisionWrapPanel" Spacing="8" RowSpacing="8">
                                                    <Button Command="{x:Bind ViewModel.MarkTranslateRequiredCommand}" Style="{StaticResource PrimaryCommandButtonStyle}">
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <SymbolIcon Symbol="World" />
                                                            <TextBlock Text="Faltan subs · usar Codex" />
                                                        </StackPanel>
                                                    </Button>
                                                    <Button Command="{x:Bind ViewModel.MarkTranslateSkippedCommand}" Style="{StaticResource DenseActionButtonStyle}">
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <SymbolIcon Symbol="Accept" />
                                                            <TextBlock Text="Ya contiene español" />
                                                        </StackPanel>
                                                    </Button>
                                                </local:ActionWrapPanel>
                                            </StackPanel>
                        <Border Style="{StaticResource CardContainerStyle}">
                                                <StackPanel Spacing="10">
                                                    <TextBlock Style="{StaticResource SectionDescriptionTextStyle}"
                            Text="{x:Bind ViewModel.QuickOptionsDescription, Mode=OneWay}" />

                                                    <Border x:Name="SkipAheadPanel" Background="Transparent">
                                                        <StackPanel Spacing="8">
                                                            <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="Preparación directa" />
                                                            <local:ActionWrapPanel x:Name="SkipAheadActionWrapPanel" Spacing="8" RowSpacing="8">
                                                                <Button Command="{x:Bind ViewModel.PrepareSelectedStepCommand}" Content="Saltar pasos previos" ToolTipService.ToolTip="Omitir los pasos anteriores y preparar la etapa seleccionada" Style="{StaticResource DenseActionButtonStyle}" />
                                                                <Button Command="{x:Bind ViewModel.PrepareAndRunSelectedStepCommand}" Content="Saltar y ejecutar" ToolTipService.ToolTip="Omitir los pasos anteriores y ejecutar esta etapa ahora" Style="{StaticResource PrimaryCommandButtonStyle}" />
                                                            </local:ActionWrapPanel>
                                                        </StackPanel>
                                                    </Border>

                                                    <Border x:Name="DownloadQuickOptionsPanel" Background="Transparent">
                                                        <local:ActionWrapPanel x:Name="DownloadQuickOptionsWrapPanel" Spacing="8" RowSpacing="8">
                                                            <ToggleButton Command="{x:Bind ViewModel.ToggleDownloadDryRunCommand}" IsChecked="{x:Bind ViewModel.DownloadDryRunEnabled, Mode=OneWay}" Style="{StaticResource QuickToggleButtonStyle}">
                                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                                    <SymbolIcon Symbol="View" />
                                                                    <TextBlock Text="{x:Bind ViewModel.DownloadDryRunButtonLabel, Mode=OneWay}" />
                                                                </StackPanel>
                                                            </ToggleButton>
                                                            <ToggleButton Command="{x:Bind ViewModel.ToggleDownloadForceLatestCommand}" IsChecked="{x:Bind ViewModel.DownloadForceLatestEnabled, Mode=OneWay}" Style="{StaticResource QuickToggleButtonStyle}">
                                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                                    <SymbolIcon Symbol="Sync" />
                                                                    <TextBlock Text="{x:Bind ViewModel.DownloadForceLatestButtonLabel, Mode=OneWay}" />
                                                                </StackPanel>
                                                            </ToggleButton>
                                                        </local:ActionWrapPanel>
                                                    </Border>

                                                    <Border
                                                        x:Name="TranslateQuickOptionsPanel"
                                                        Padding="12"
                                                        Background="{ThemeResource DashboardPanelBrush}"
                                                        BorderBrush="{ThemeResource HairlineBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="10">
                                                        <StackPanel Spacing="10">
                                                            <Grid ColumnSpacing="10">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <Border
                                                                    Width="42"
                                                                    Height="42"
                                                                    Background="{ThemeResource DashboardChipBrush}"
                                                                    CornerRadius="9">
                                                                    <SymbolIcon
                                                                        HorizontalAlignment="Center"
                                                                        VerticalAlignment="Center"
                                                                        Foreground="{ThemeResource AccentSecondaryBrush}"
                                                                        Symbol="World" />
                                                                </Border>
                                                                <StackPanel Grid.Column="1" Spacing="4">
                                                                    <TextBlock
                                                                        FontSize="17"
                                                                        FontWeight="SemiBold"
                                                                        Foreground="{ThemeResource TextPrimaryBrush}"
                                                                        Text="{x:Bind ViewModel.CodexTranslationPanelTitle, Mode=OneWay}" />
                                                                    <TextBlock
                                                                        MaxWidth="980"
                                                                        HorizontalAlignment="Left"
                                                                        Foreground="{ThemeResource TextSecondaryBrush}"
                                                                        Text="{x:Bind ViewModel.CodexTranslationPanelDescription, Mode=OneWay}"
                                                                        TextWrapping="WrapWholeWords" />
                                                                </StackPanel>
                                                            </Grid>

                                                            <Border
                                                                Padding="10,8"
                                                                Background="{ThemeResource InsetSurfaceBrush}"
                                                                BorderBrush="{ThemeResource HairlineBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="7">
                                                                <StackPanel Spacing="3">
                                                                    <TextBlock
                                                                        FontSize="11"
                                                                        FontWeight="SemiBold"
                                                                        Foreground="{ThemeResource AccentSecondaryBrush}"
                                                                        Text="ARCHIVO QUE RECIBIRÁ CODEX" />
                                                                    <TextBlock
                                                                        FontFamily="Consolas"
                                                                        Foreground="{ThemeResource TextPrimaryBrush}"
                                                                        Text="{x:Bind ViewModel.CodexTranslationTargetLabel, Mode=OneWay}"
                                                                        TextTrimming="CharacterEllipsis"
                                                                        TextWrapping="NoWrap" />
                                                                    <TextBlock
                                                                        Style="{StaticResource MutedCaptionTextStyle}"
                                                                        Text="{x:Bind ViewModel.CodexTranslationExpectedOutputLabel, Mode=OneWay}" />
                                                                </StackPanel>
                                                            </Border>

                                                            <local:ActionWrapPanel x:Name="TranslateQuickOptionsWrapPanel" Spacing="8" RowSpacing="8">
                                                                <Button Command="{x:Bind ViewModel.OpenCodexTranslationCommand}" Style="{StaticResource PrimaryCommandButtonStyle}">
                                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                                        <SymbolIcon Symbol="Send" />
                                                                        <TextBlock Text="Copiar solicitud y abrir Codex" />
                                                                    </StackPanel>
                                                                </Button>
                                                                <Button Command="{x:Bind ViewModel.ConfirmCodexTranslationCommand}" Style="{StaticResource DenseActionButtonStyle}">
                                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                                        <SymbolIcon Symbol="Sync" />
                                                                        <TextBlock Text="Detectar MKV traducido" />
                                                                    </StackPanel>
                                                                </Button>
                                                                <Button Command="{x:Bind ViewModel.CopyCodexTranslationRequestCommand}" Style="{StaticResource DenseActionButtonStyle}">
                                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                                        <SymbolIcon Symbol="Copy" />
                                                                        <TextBlock Text="Copiar solicitud" />
                                                                    </StackPanel>
                                                                </Button>
                                                                <Button Command="{x:Bind ViewModel.OpenTranslationFolderCommand}" Style="{StaticResource DenseActionButtonStyle}">
                                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                                        <SymbolIcon Symbol="Folder" />
                                                                        <TextBlock Text="Abrir carpeta" />
                                                                    </StackPanel>
                                                                </Button>
                                                            </local:ActionWrapPanel>

                                                            <TextBlock
                                                                Foreground="{ThemeResource TextSecondaryBrush}"
                                                                Text="Al regresar, pulsa “Detectar MKV traducido”. El siguiente paso solo se habilitará cuando el archivo exista."
                                                                TextWrapping="WrapWholeWords" />
                                                        </StackPanel>
                                                    </Border>

                                                    <Border
                                                        x:Name="CleanTracksQuickOptionsPanel"
                                                        Padding="12"
                                                        Background="{StaticResource DashboardPanelBrush}"
                                                        BorderBrush="{StaticResource HairlineBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="8">
                                                        <StackPanel Spacing="12">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel Spacing="6">
                                                                    <TextBlock Style="{StaticResource DashboardSectionHeadingTextStyle}" Text="Selección de pistas" />
                                                                    <TextBlock
                                                                        HorizontalAlignment="Left"
                                                                        MaxWidth="860"
                                                                        Style="{StaticResource SectionDescriptionTextStyle}"
                                                                        Text="Conserva solo las pistas correctas, marca la principal y mantiene visibles los casos especiales." />
                                                                </StackPanel>
                                                                <SymbolIcon
                                                                    Grid.Column="1"
                                                                    Foreground="{StaticResource TextPrimaryBrush}"
                                                                    Opacity="0.88"
                                                                    Symbol="Up" />
                                                            </Grid>

                                                            <local:ActionWrapPanel x:Name="CleanupFlagsWrapPanel" Spacing="8" RowSpacing="8">
                                                                <ToggleButton Command="{x:Bind ViewModel.ToggleCleanupCloseQbittorrentCommand}" IsChecked="{x:Bind ViewModel.CleanupCloseQbittorrentEnabled, Mode=OneWay}" Style="{StaticResource CleanTracksToggleButtonStyle}">
                                                                    <ToggleButton.Resources>
                                                                        <SolidColorBrush x:Key="ToggleButtonBackground" Color="#262E3747" />
                                                                        <SolidColorBrush x:Key="ToggleButtonBackgroundPointerOver" Color="#34405266" />
                                                                        <SolidColorBrush x:Key="ToggleButtonBackgroundPressed" Color="#3E4C6078" />
                                                                        <SolidColorBrush x:Key="ToggleButtonBorderBrush" Color="#66748799" />
                                                                        <SolidColorBrush x:Key="ToggleButtonForeground" Color="#FFD9E2F1" />
                                                                        <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#4A23496B" />
                                                                        <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#5B2B5A7F" />
                                                                        <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#6B336993" />
                                                                        <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="#A56EC8FF" />
                                                                        <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPointerOver" Color="#BF82D5FF" />
                                                                        <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="#FFFFFFFF" />
                                                                    </ToggleButton.Resources>
                                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                                        <SymbolIcon Symbol="Cancel" />
                                                                        <TextBlock Text="{x:Bind ViewModel.CleanupCloseQbittorrentButtonLabel, Mode=OneWay}" />
                                                                    </StackPanel>
                                                                </ToggleButton>
                                                                <ToggleButton Command="{x:Bind ViewModel.ToggleCleanupDeleteOriginalsCommand}" IsChecked="{x:Bind ViewModel.CleanupDeleteOriginalsEnabled, Mode=OneWay}" Style="{StaticResource CleanTracksToggleButtonStyle}">
                                                                    <ToggleButton.Resources>
                                                                        <SolidColorBrush x:Key="ToggleButtonBackground" Color="#262E3747" />
                                                                        <SolidColorBrush x:Key="ToggleButtonBackgroundPointerOver" Color="#34405266" />
                                                                        <SolidColorBrush x:Key="ToggleButtonBackgroundPressed" Color="#3E4C6078" />
                                                                        <SolidColorBrush x:Key="ToggleButtonBorderBrush" Color="#66748799" />
                                                                        <SolidColorBrush x:Key="ToggleButtonForeground" Color="#FFD9E2F1" />
                                                                        <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#5C3B1418" />
                                                                        <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#70471A20" />
                                                                        <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#85552028" />
                                                                        <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="#D9824A52" />
                                                                        <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPointerOver" Color="#F09A6068" />
                                                                        <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="#FFFFFFFF" />
                                                                    </ToggleButton.Resources>
                                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                                        <SymbolIcon Symbol="Delete" />
                                                                        <TextBlock Text="{x:Bind ViewModel.CleanupDeleteOriginalsButtonLabel, Mode=OneWay}" />
                                                                    </StackPanel>
                                                                </ToggleButton>
                                                            </local:ActionWrapPanel>

                                                            <Border Height="1" Background="{StaticResource HairlineBrush}" />

                                                            <StackPanel Spacing="8">
                                                                <TextBlock FontSize="16" FontWeight="SemiBold" Text="Revisión de layouts" />
                                                                <TextBlock
                                                                    HorizontalAlignment="Left"
                                                                    MaxWidth="980"
                                                                    Style="{StaticResource SectionDescriptionTextStyle}"
                                                                    Text="{x:Bind ViewModel.CleanupSpecialCasesPanelMessage, Mode=OneWay}" />
                                                                <TextBlock
                                                                    FontFamily="Consolas"
                                                                    Foreground="{StaticResource TextSecondaryBrush}"
                                                                    Text="{x:Bind ViewModel.CleanupSpecialCasesListText, Mode=OneWay}"
                                                                    TextWrapping="Wrap" />
                                                            </StackPanel>

                                                            <Border Height="1" Background="{StaticResource HairlineBrush}" />

                                                            <StackPanel Spacing="10">
                                                                <TextBlock FontSize="16" FontWeight="SemiBold" Text="Audios" />
                                                                <TextBlock
                                                                    HorizontalAlignment="Left"
                                                                    MaxWidth="980"
                                                                    Style="{StaticResource SectionDescriptionTextStyle}"
                                                                    Text="{x:Bind ViewModel.CleanupAudioSelectionMessage, Mode=OneWay}" />
                                                                <local:ActionWrapPanel x:Name="CleanupAudioActionWrapPanel" Spacing="8" RowSpacing="8">
                                                                    <Button Command="{x:Bind ViewModel.RefreshCleanupAudioOptionsCommand}" Style="{StaticResource DenseActionButtonStyle}">
                                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                                            <SymbolIcon Symbol="Sync" />
                                                                            <TextBlock Text="{x:Bind ViewModel.CleanupAudioRefreshButtonLabel, Mode=OneWay}" />
                                                                        </StackPanel>
                                                                    </Button>
                                                                    <Button Command="{x:Bind ViewModel.SelectAllCleanupAudiosCommand}" IsEnabled="{x:Bind ViewModel.HasCleanupAudioOptions, Mode=OneWay}" Style="{StaticResource DenseActionButtonStyle}">
                                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                                            <SymbolIcon Symbol="Accept" />
                                                                            <TextBlock Text="Conservar todos" />
                                                                        </StackPanel>
                                                                    </Button>
                                                                    <Button Command="{x:Bind ViewModel.ClearCleanupAudioSelectionCommand}" IsEnabled="{x:Bind ViewModel.HasCleanupAudioOptions, Mode=OneWay}" Style="{StaticResource DenseActionButtonStyle}">
                                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                                            <SymbolIcon Symbol="Cancel" />
                                                                            <TextBlock Text="Quitar todos" />
                                                                        </StackPanel>
                                                                    </Button>
                                                                </local:ActionWrapPanel>
                                                                <TextBlock Style="{StaticResource MutedCaptionTextStyle}" Text="Ámbar = se conserva · Verde = principal" />
                                                                <ItemsControl ItemsSource="{x:Bind ViewModel.CleanupAudioOptions, Mode=OneWay}">
                                                                    <ItemsControl.ItemsPanel>
                                                                        <ItemsPanelTemplate>
                                                                            <ItemsWrapGrid Orientation="Horizontal" />
                                                                        </ItemsPanelTemplate>
                                                                    </ItemsControl.ItemsPanel>
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate x:DataType="models:TrackCleanupAudioOption">
                                                                            <Border
                                                                                Width="330"
                                                                                Margin="0,0,8,8"
                                                                                Background="{x:Bind CardBackgroundBrush, Mode=OneWay}"
                                                                                BorderBrush="{x:Bind CardBorderBrush, Mode=OneWay}"
                                                                                BorderThickness="2"
                                                                                CornerRadius="8">
                                                                                <Grid MinHeight="82" Padding="8,6,10,6" ColumnSpacing="8">
                                                                                    <Grid.RowDefinitions>
                                                                                        <RowDefinition Height="*" />
                                                                                    </Grid.RowDefinitions>
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="38" />
                                                                                        <ColumnDefinition Width="*" />
                                                                                        <ColumnDefinition Width="54" />
                                                                                    </Grid.ColumnDefinitions>
                                                                                    <Button
                                                                                        Grid.Column="0"
                                                                                        Width="32"
                                                                                        Height="32"
                                                                                        Padding="0"
                                                                                        Background="{x:Bind SelectorBackgroundBrush, Mode=OneWay}"
                                                                                        BorderBrush="{x:Bind SelectorBorderBrush, Mode=OneWay}"
                                                                                        BorderThickness="1"
                                                                                        Command="{Binding ViewModel.ToggleCleanupAudioSelectionCommand, ElementName=RootPage}"
                                                                                        CommandParameter="{Binding}"
                                                                                        CornerRadius="9"
                                                                                        HorizontalAlignment="Center"
                                                                                        ToolTipService.ToolTip="Conservar pista"
                                                                                        VerticalAlignment="Center">
                                                                                        <SymbolIcon
                                                                                            Width="17"
                                                                                            Height="17"
                                                                                            Foreground="{x:Bind SelectorGlyphBrush, Mode=OneWay}"
                                                                                            Symbol="Accept" />
                                                                                    </Button>
                                                                                    <Grid Grid.Column="1" MinWidth="0" RowSpacing="5" VerticalAlignment="Center">
                                                                                        <Grid.RowDefinitions>
                                                                                            <RowDefinition Height="Auto" />
                                                                                            <RowDefinition Height="Auto" />
                                                                                        </Grid.RowDefinitions>
                                                                                        <Grid ColumnSpacing="6" MinWidth="0">
                                                                                            <Grid.ColumnDefinitions>
                                                                                                <ColumnDefinition Width="Auto" />
                                                                                                <ColumnDefinition Width="*" />
                                                                                            </Grid.ColumnDefinitions>
                                                                                            <Border
                                                                                                Grid.Column="0"
                                                                                                Width="24"
                                                                                                Height="24"
                                                                                                Background="#26101814"
                                                                                                BorderBrush="{x:Bind CardBorderBrush, Mode=OneWay}"
                                                                                                BorderThickness="1"
                                                                                                CornerRadius="6"
                                                                                                VerticalAlignment="Top">
                                                                                                <TextBlock
                                                                                                    FontFamily="Segoe UI Symbol"
                                                                                                    FontSize="13"
                                                                                                    FontWeight="SemiBold"
                                                                                                    Foreground="{x:Bind TitleBrush, Mode=OneWay}"
                                                                                                    HorizontalAlignment="Center"
                                                                                                    Text="♪"
                                                                                                    VerticalAlignment="Center" />
                                                                                            </Border>
                                                                                            <TextBlock
                                                                                                Grid.Column="1"
                                                                                                FontSize="13"
                                                                                                FontWeight="SemiBold"
                                                                                                Foreground="{x:Bind TitleBrush, Mode=OneWay}"
                                                                                                MaxLines="2"
                                                                                                Text="{x:Bind PrimaryLabel, Mode=OneWay}"
                                                                                                TextTrimming="CharacterEllipsis"
                                                                                                TextWrapping="WrapWholeWords" />
                                                                                        </Grid>
                                                                                        <TextBlock
                                                                                            Grid.Row="1"
                                                                                            Margin="23,0,0,0"
                                                                                            FontSize="10"
                                                                                            FontWeight="SemiBold"
                                                                                            Foreground="{x:Bind CaptionBrush, Mode=OneWay}"
                                                                                            MaxLines="2"
                                                                                            Opacity="0.82"
                                                                                            Text="{x:Bind SecondaryLabel, Mode=OneWay}"
                                                                                            TextTrimming="CharacterEllipsis"
                                                                                            TextWrapping="WrapWholeWords" />
                                                                                    </Grid>
                                                                                    <StackPanel
                                                                                        Grid.Column="2"
                                                                                        MinWidth="0"
                                                                                        Spacing="7"
                                                                                        VerticalAlignment="Center">
                                                                                        <Button
                                                                                            Width="36"
                                                                                            Height="36"
                                                                                            Padding="0"
                                                                                            Background="#33231814"
                                                                                            BorderBrush="{x:Bind CardBorderBrush, Mode=OneWay}"
                                                                                            BorderThickness="1"
                                                                                            CornerRadius="9"
                                                                                            HorizontalAlignment="Right"
                                                                                            HorizontalContentAlignment="Center"
                                                                                            MinHeight="0"
                                                                                            MinWidth="0"
                                                                                            ToolTipService.ToolTip="Editar metadata"
                                                                                            VerticalContentAlignment="Center">
                                                                                            <Button.Flyout>
                                                                                                <Flyout>
                                                                                                    <StackPanel MinWidth="300" Spacing="10">
                                                                                                        <TextBox Header="Código de idioma" Text="{x:Bind LanguageCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                                                                        <TextBox Header="Etiqueta visible" Text="{x:Bind LanguageLabel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                                                                        <TextBox Header="Codec" Text="{x:Bind Codec, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                                                                        <TextBox Header="Nombre de pista" Text="{x:Bind Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" />
                                                                                                        <Button Command="{Binding ViewModel.SaveCleanupMetadataCommand, ElementName=RootPage}" Style="{StaticResource PrimaryCommandButtonStyle}">
                                                                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                                                                <SymbolIcon Symbol="Save" />
                                                                                                                <TextBlock Text="Guardar metadata" />
                                                                                                            </StackPanel>
                                                                                                        </Button>
                                                                                                    </StackPanel>
                                                                                                </Flyout>
                                                                                            </Button.Flyout>
                                                                                            <Grid Width="18" Height="18">
                                                                                                <FontIcon
                                                                                                    FontFamily="Segoe MDL2 Assets"
                                                                                                    FontSize="15"
                                                                                                    Foreground="{StaticResource TextPrimaryBrush}"
                                                                                                    Glyph="&#xE70F;"
                                                                                                    HorizontalAlignment="Center"
                                                                                                    VerticalAlignment="Center" />
                                                                                            </Grid>
                                                                                        </Button>
                                                                                        <Button
                                                                                            Command="{Binding ViewModel.MarkCleanupAudioPrimaryCommand, ElementName=RootPage}"
