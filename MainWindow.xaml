<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="MediaWorkflowOrchestrator.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid x:Name="RootShell" Loaded="OnRootShellLoaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.RowSpan="2" Background="{StaticResource WindowBackdropBrush}">
            <Rectangle Fill="{StaticResource CinematicVeilBrush}" />
        </Grid>

        <Grid x:Name="ShellHeaderLayout" Margin="8,0,8,6">
            <Border
                x:Name="ShellWorkflowHeader"
                Padding="12,7"
                Background="{StaticResource DashboardPanelBrush}"
                BorderBrush="{StaticResource HairlineBrush}"
                BorderThickness="0,0,0,1"
                CornerRadius="7">
                <Grid ColumnSpacing="14" RowSpacing="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid MinWidth="0" ColumnSpacing="18" RowSpacing="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Ellipse
                                Width="8"
                                Height="8"
                                Fill="{StaticResource AccentSecondaryBrush}"
                                VerticalAlignment="Center" />
                            <TextBlock
                                FontSize="15"
                                FontWeight="SemiBold"
                                MaxLines="1"
                                Text="{Binding DisplayName}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock
                            Grid.Row="1"
                            Margin="16,0,0,0"
                            MaxLines="1"
                            Style="{StaticResource MonoCaptionTextStyle}"
                            Text="{Binding RootPath}"
                            TextTrimming="CharacterEllipsis" />

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                            <TextBlock Style="{StaticResource MutedCaptionTextStyle}" Text="Siguiente" />
                            <TextBlock
                                FontSize="13"
                                FontWeight="SemiBold"
                                MaxLines="1"
                                Text="{Binding NextStepLabel}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="1"
                            MaxLines="1"
                            Style="{StaticResource MutedCaptionTextStyle}"
                            Text="{Binding StatusMessage}"
                            TextTrimming="CharacterEllipsis"
                            ToolTipService.ToolTip="{Binding StatusMessage}" />

                        <StackPanel Grid.Column="2" Grid.RowSpan="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Ellipse Width="7" Height="7" Fill="{StaticResource AccentSecondaryBrush}" />
                            <TextBlock
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource AccentSecondaryBrush}"
                                Text="{Binding GlobalStatus}" />
                        </StackPanel>
                    </Grid>

                    <CommandBar
                        x:Name="ShellCommandBar"
                        Grid.Column="1"
                        Background="Transparent"
                        ClosedDisplayMode="Compact"
                        DefaultLabelPosition="Right"
                        IsDynamicOverflowEnabled="True"
                        IsOpen="False">
                        <AppBarButton
                            Click="OnQuickRunNextClicked"
                            Icon="Play"
                            Label="Ejecutar siguiente"
                            Background="{StaticResource RunNextBackgroundBrush}"
                            BorderBrush="{StaticResource RunNextBorderBrush}"
                            Foreground="{StaticResource RunNextForegroundBrush}"
                            Style="{StaticResource ColoredCommandAppBarButtonStyle}"
                            ToolTipService.ToolTip="Ejecutar el siguiente paso disponible" />
                        <AppBarButton
                            x:Name="QuickRunSelectedButton"
                            Click="OnQuickRunSelectedClicked"
                            Icon="Forward"
                            Label="Ejecutar seleccionado"
                            Background="{StaticResource RunSelectedBackgroundBrush}"
                            BorderBrush="{StaticResource RunSelectedBorderBrush}"
                            Foreground="{StaticResource RunSelectedForegroundBrush}"
                            Style="{StaticResource ColoredCommandAppBarButtonStyle}"
                            ToolTipService.ToolTip="Ejecutar el paso seleccionado" />

                        <CommandBar.SecondaryCommands>
                            <AppBarButton Click="OnQuickRetryClicked" Icon="Refresh" Label="Reintentar paso" />
                            <AppBarButton Click="OnQuickSkipClicked" Icon="Redo" Label="Omitir paso seleccionado" />
                            <AppBarButton Click="OnQuickCancelClicked" Icon="Cancel" Label="Cancelar ejecución actual" />
                        </CommandBar.SecondaryCommands>
                    </CommandBar>

                    <Border
                        Grid.Row="1"
                        Grid.ColumnSpan="2"
                        Padding="0,4,0,0"
                        BorderBrush="{StaticResource HairlineBrush}"
                        BorderThickness="0,1,0,0">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border
                                x:Name="ShellProgressMonitor"
                                MinWidth="240"
                                Padding="10,6"
                                Background="{StaticResource DashboardInfoBrush}"
                                BorderBrush="{StaticResource HairlineBrush}"
                                BorderThickness="1"
                                CornerRadius="7"
                                Visibility="Collapsed">
                                <Grid ColumnSpacing="8" RowSpacing="3">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <ProgressRing
                                        Grid.RowSpan="2"
                                        Width="20"
                                        Height="20"
                                        VerticalAlignment="Center"
                                        Foreground="{StaticResource AccentSecondaryBrush}"
                                        IsActive="{Binding IsProgressOperationActive}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        MaxLines="1"
                                        Text="{Binding DetailProgressPhaseLabel}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Grid.Column="2"
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource AccentSecondaryBrush}"
                                        Text="{Binding DetailProgressPercentLabel}" />
                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Grid.ColumnSpan="2"
                                        MaxLines="1"
                                        Style="{StaticResource MutedCaptionTextStyle}"
                                        Text="{Binding DetailProgressMessage}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTipService.ToolTip="{Binding DetailProgressMessage}" />
                                    <ProgressBar
                                        Grid.Row="2"
                                        Grid.ColumnSpan="3"
                                        Height="5"
                                        Foreground="{StaticResource AccentSecondaryBrush}"
                                        IsIndeterminate="{Binding DetailProgressIsIndeterminate}"
                                        Maximum="100"
                                        Minimum="0"
                                        Value="{Binding DetailProgressValue}" />

                                    <Grid Grid.Row="3" Grid.ColumnSpan="3" Margin="0,2,0,0" ColumnSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource MutedCaptionTextStyle}" Text="Actual" />
                                        <TextBlock
                                            Grid.Column="1"
                                            FontSize="11"
                                            MaxLines="1"
                                            Text="{Binding DetailItemProgressTitle}"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTipService.ToolTip="{Binding DetailItemProgressTitle}" />
                                        <TextBlock
                                            Grid.Column="2"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Text="{Binding DetailItemProgressPercentLabel}" />
                                    </Grid>
                                    <ProgressBar
                                        Grid.Row="4"
                                        Grid.ColumnSpan="3"
                                        Height="4"
                                        Foreground="{StaticResource AccentPrimaryBrush}"
                                        IsIndeterminate="{Binding DetailItemProgressIsIndeterminate}"
                                        Maximum="100"
                                        Minimum="0"
                                        Value="{Binding DetailItemProgressValue}" />
                                </Grid>
                            </Border>

                            <ScrollViewer
                                Grid.Column="1"
                                HorizontalScrollBarVisibility="Hidden"
                                HorizontalScrollMode="Auto"
                                VerticalScrollBarVisibility="Disabled"
                                VerticalScrollMode="Disabled">
                                <CommandBar
                                    x:Name="QuickAccessCommandBar"
                                    Background="Transparent"
                                    ClosedDisplayMode="Compact"
                                    DefaultLabelPosition="Right"
                                    IsDynamicOverflowEnabled="False"
                                    IsOpen="False"
                                    OverflowButtonVisibility="Collapsed">
                                    <AppBarButton
                                        Click="OnQuickPickFileClicked"
                                        Icon="Document"
                                        Label="Elegir archivo base"
                                        Background="{StaticResource QuickFileBackgroundBrush}"
                                        BorderBrush="{StaticResource QuickFileBorderBrush}"
                                        Foreground="{StaticResource QuickFileForegroundBrush}"
                                        Style="{StaticResource ColoredCommandAppBarButtonStyle}" />
                                    <AppBarButton
                                        Click="OnQuickPickFolderClicked"
                                        Icon="Folder"
                                        Label="Elegir carpeta del release"
                                        Background="{StaticResource QuickFolderBackgroundBrush}"
                                        BorderBrush="{StaticResource QuickFolderBorderBrush}"
                                        Foreground="{StaticResource QuickFolderForegroundBrush}"
                                        Style="{StaticResource ColoredCommandAppBarButtonStyle}" />
                                    <AppBarButton
                                        Click="OnQuickDownloadWeeklyClicked"
                                        Icon="Download"
                                        Label="Descarga semanal desde Nyaa"
                                        Background="{StaticResource QuickWeeklyBackgroundBrush}"
                                        BorderBrush="{StaticResource QuickWeeklyBorderBrush}"
                                        Foreground="{StaticResource QuickWeeklyForegroundBrush}"
                                        Style="{StaticResource ColoredCommandAppBarButtonStyle}" />
                                    <AppBarButton
                                        Click="OnQuickDownloadFromLinkClicked"
                                        Icon="World"
                                        Label="Descargar desde link de Nyaa"
                                        Background="{StaticResource QuickLinkBackgroundBrush}"
                                        BorderBrush="{StaticResource QuickLinkBorderBrush}"
                                        Foreground="{StaticResource QuickLinkForegroundBrush}"
                                        Style="{StaticResource ColoredCommandAppBarButtonStyle}" />
                                    <AppBarSeparator />
                                    <AppBarButton
                                        Click="OnQuickOpenFolderClicked"
                                        Icon="OpenFile"
                                        Label="Abrir carpeta del workflow"
                                        Background="{StaticResource QuickOpenFolderBackgroundBrush}"
                                        BorderBrush="{StaticResource QuickOpenFolderBorderBrush}"
                                        Foreground="{StaticResource QuickOpenFolderForegroundBrush}"
                                        Style="{StaticResource ColoredCommandAppBarButtonStyle}" />
                                    <AppBarButton
                                        Click="OnQuickOpenLogClicked"
                                        Icon="Page"
                                        Label="Abrir log del paso"
                                        Background="{StaticResource QuickLogBackgroundBrush}"
                                        BorderBrush="{StaticResource QuickLogBorderBrush}"
                                        Foreground="{StaticResource QuickLogForegroundBrush}"
                                        Style="{StaticResource ColoredCommandAppBarButtonStyle}" />
                                </CommandBar>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <NavigationView
            x:Name="AppNavigationView"
            Grid.Row="1"
            Background="Transparent"
            CompactPaneLength="48"
            IsBackButtonVisible="Collapsed"
            IsPaneOpen="False"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="False"
            IsTitleBarAutoPaddingEnabled="False"
            OpenPaneLength="224"
            PaneDisplayMode="LeftCompact"
            ItemInvoked="OnNavigationItemInvoked"
            SelectionChanged="OnNavigationSelectionChanged">
            <NavigationView.PaneHeader>
                <Grid Margin="8,6,8,8" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Width="32"
                        Height="32"
                        Background="{StaticResource AccentPrimaryBrush}"
                        CornerRadius="7">
                        <SymbolIcon
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource AccentForegroundBrush}"
                            Symbol="Library" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="0">
                        <TextBlock FontSize="14" FontWeight="SemiBold" Text="Media Workflow" />
                        <TextBlock Style="{StaticResource MutedCaptionTextStyle}" Text="Ejecución local" />
                    </StackPanel>
                </Grid>
            </NavigationView.PaneHeader>

            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="DashboardItem" Content="Panel" Icon="Home" Tag="dashboard" />
                <NavigationViewItem Content="Herramientas" Icon="Setting" Tag="tools" />
                <NavigationViewItem Content="Historial" Icon="Clock" Tag="history" />
                <NavigationViewItem Content="Recargar app" Icon="Refresh" SelectsOnInvoked="False" Tag="reload" />
            </NavigationView.MenuItems>

            <Frame x:Name="ContentFrame" Margin="0,0,8,8" />
        </NavigationView>
    </Grid>
</Window>
