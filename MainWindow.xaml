<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="MediaWorkflowOrchestrator.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid x:Name="RootShell" Loaded="OnRootShellLoaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.RowSpan="2" Background="{StaticResource WindowBackdropBrush}">
            <Rectangle Fill="{StaticResource CinematicVeilBrush}" />
        </Grid>

        <Grid x:Name="ShellHeaderLayout" Margin="8,0,8,6">
            <Border
                x:Name="ShellWorkflowHeader"
                Padding="12,6"
                Background="{StaticResource DashboardPanelBrush}"
                BorderBrush="{StaticResource HairlineBrush}"
                BorderThickness="0,0,0,1"
                CornerRadius="7">
                <Grid ColumnSpacing="14" RowSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid MinWidth="0" ColumnSpacing="12" RowSpacing="2" VerticalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Ellipse
                                Width="8"
                                Height="8"
                                Fill="{StaticResource AccentSecondaryBrush}"
                                VerticalAlignment="Center" />
                            <TextBlock
                                Grid.Column="1"
                                FontSize="14"
                                FontWeight="SemiBold"
                                MaxLines="1"
                                Text="{Binding DisplayName}"
                                TextTrimming="CharacterEllipsis" />
                        </Grid>
                        <TextBlock
                            Grid.Row="1"
                            Margin="16,0,0,0"
                            MaxLines="1"
                            Style="{StaticResource MonoCaptionTextStyle}"
                            Text="{Binding RootPath}"
                            TextTrimming="CharacterEllipsis" />

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                            <TextBlock Style="{StaticResource MutedCaptionTextStyle}" Text="Siguiente" />
                            <TextBlock
                                FontSize="13"
                                FontWeight="SemiBold"
                                MaxLines="1"
                                Text="{Binding NextStepLabel}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="1"
                            MaxLines="1"
                            Style="{StaticResource MutedCaptionTextStyle}"
                            Text="{Binding StatusMessage}"
                            TextTrimming="CharacterEllipsis"
                            ToolTipService.ToolTip="{Binding StatusMessage}" />

                        <StackPanel Grid.Column="2" Grid.RowSpan="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Ellipse Width="7" Height="7" Fill="{StaticResource AccentSecondaryBrush}" />
                            <TextBlock
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource AccentSecondaryBrush}"
                                Text="{Binding GlobalStatus}" />
                        </StackPanel>
                    </Grid>

                    <CommandBar
                        x:Name="ShellCommandBar"
                        Grid.Column="1"
                        Background="Transparent"
                        ClosedDisplayMode="Compact"
                        DefaultLabelPosition="Right"
                        IsDynamicOverflowEnabled="True"
                        IsOpen="False">
                        <AppBarButton
                            Click="OnQuickRunNextClicked"
                            Icon="Play"
                            Label="Siguiente"
                            Background="{StaticResource RunNextBackgroundBrush}"
                            BorderBrush="{StaticResource RunNextBorderBrush}"
                            Foreground="{StaticResource RunNextForegroundBrush}"
                            Style="{StaticResource ColoredCommandAppBarButtonStyle}"
                            ToolTipService.ToolTip="Ejecutar el siguiente paso disponible" />
                        <AppBarButton
                            x:Name="QuickRunSelectedButton"
                            Click="OnQuickRunSelectedClicked"
                            Icon="Forward"
                            Label="Ejecutar etapa"
                            Background="{StaticResource RunSelectedBackgroundBrush}"
                            BorderBrush="{StaticResource RunSelectedBorderBrush}"
                            Foreground="{StaticResource RunSelectedForegroundBrush}"
                            Style="{StaticResource ColoredCommandAppBarButtonStyle}"
                            ToolTipService.ToolTip="Ejecutar el paso seleccionado" />

                        <CommandBar.SecondaryCommands>
                            <AppBarButton Click="OnQuickRetryClicked" Icon="Refresh" Label="Reintentar paso" />
                            <AppBarButton Click="OnQuickSkipClicked" Icon="Redo" Label="Omitir paso seleccionado" />
                            <AppBarButton Click="OnQuickCancelClicked" Icon="Cancel" Label="Cancelar ejecución actual" />
                        </CommandBar.SecondaryCommands>
                    </CommandBar>

                    <Border
                        Grid.Row="1"
                        Grid.ColumnSpan="2"
                        Padding="0,4,0,0"
                        BorderBrush="{StaticResource HairlineBrush}"
                        BorderThickness="0,1,0,0">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border
                                x:Name="ShellProgressMonitor"
                                MinWidth="0"
                                HorizontalAlignment="Stretch"
                                Padding="0,2,12,2"
                                VerticalAlignment="Center"
                                Visibility="Collapsed">
                                <Grid ColumnSpacing="8" RowSpacing="3">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock FontSize="12" FontWeight="SemiBold"
                                        Text="{Binding DetailProgressPhaseLabel}" TextTrimming="CharacterEllipsis"
                                        ToolTipService.ToolTip="{Binding DetailProgressMessage}" />
                                    <TextBlock Grid.Column="1" FontSize="12" Foreground="{StaticResource AccentSecondaryBrush}"
                                        Text="{Binding DetailProgressPercentLabel}" />
                                    <ProgressBar x:Name="ShellOverallProgressBar" Grid.Row="1" Grid.ColumnSpan="2" Height="3" HorizontalAlignment="Stretch"
                                        Foreground="{StaticResource AccentSecondaryBrush}"
                                        IsIndeterminate="{Binding DetailProgressIsIndeterminate}"
                                        Maximum="100" Value="{Binding DetailProgressValue}" />
                                    <Grid Grid.Row="2" Grid.ColumnSpan="2" ColumnSpacing="6">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource MutedCaptionTextStyle}" MaxLines="1"
                                            Text="{Binding DetailItemProgressTitle}" TextTrimming="CharacterEllipsis"
                                            ToolTipService.ToolTip="{Binding DetailItemProgressTitle}" />
                                        <TextBlock Grid.Column="1" Style="{StaticResource MutedCaptionTextStyle}"
                                            Text="{Binding DetailItemProgressPercentLabel}" />
                                    </Grid>
                                </Grid>
                            </Border>

                            <CommandBar
                                    x:Name="QuickAccessCommandBar"
                                    Grid.Column="1"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Center"
                                    Background="Transparent"
                                    ClosedDisplayMode="Compact"
                                    DefaultLabelPosition="Right"
                                    IsDynamicOverflowEnabled="True"
                                    IsOpen="False"
                                    OverflowButtonVisibility="Auto">
                                    <AppBarButton
                                        Click="OnQuickPickFileClicked"
                                        Icon="Document"
                                        Label="Archivo base" ToolTipService.ToolTip="Elegir archivo base"
                                        Style="{StaticResource SecondaryCommandAppBarButtonStyle}" />
                                    <AppBarButton
                                        Click="OnQuickPickFolderClicked"
                                        Icon="Folder"
                                        Label="Carpeta del release" ToolTipService.ToolTip="Elegir carpeta del release"
                                        Style="{StaticResource SecondaryCommandAppBarButtonStyle}" />
                                    <AppBarButton
                                        Click="OnQuickDownloadWeeklyClicked"
                                        Icon="Download"
                                        Label="Nyaa semanal" ToolTipService.ToolTip="Descarga semanal desde Nyaa"
                                        Style="{StaticResource SecondaryCommandAppBarButtonStyle}" />
                                    <AppBarButton
                                        Click="OnQuickDownloadFromLinkClicked"
                                        Icon="World"
                                        Label="Enlace Nyaa" ToolTipService.ToolTip="Descargar desde link de Nyaa"
                                        Style="{StaticResource SecondaryCommandAppBarButtonStyle}" />
                                    <AppBarSeparator />
                                    <AppBarButton
                                        Click="OnQuickOpenFolderClicked"
                                        Icon="OpenFile"
                                        Label="Abrir carpeta" ToolTipService.ToolTip="Abrir carpeta del workflow"
                                        Style="{StaticResource SecondaryCommandAppBarButtonStyle}" />
                                    <AppBarButton
                                        Click="OnQuickOpenLogClicked"
                                        Icon="Page"
                                        Label="Abrir log" ToolTipService.ToolTip="Abrir log del paso"
                                        Style="{StaticResource SecondaryCommandAppBarButtonStyle}" />
                                </CommandBar>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <NavigationView
            x:Name="AppNavigationView"
            Grid.Row="1"
            Background="Transparent"
            CompactPaneLength="48"
            IsBackButtonVisible="Collapsed"
            IsPaneOpen="False"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="False"
            IsTitleBarAutoPaddingEnabled="False"
            OpenPaneLength="224"
            PaneDisplayMode="LeftCompact"
            ItemInvoked="OnNavigationItemInvoked"
            SelectionChanged="OnNavigationSelectionChanged">
            <NavigationView.PaneHeader>
                <Grid Margin="8,6,8,8" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Width="32"
                        Height="32"
                        Background="{StaticResource AccentPrimaryBrush}"
                        CornerRadius="7">
                        <SymbolIcon
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource AccentForegroundBrush}"
                            Symbol="Library" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="0">
                        <TextBlock FontSize="14" FontWeight="SemiBold" Text="Media Workflow" />
                        <TextBlock Style="{StaticResource MutedCaptionTextStyle}" Text="Ejecución local" />
                    </StackPanel>
                </Grid>
            </NavigationView.PaneHeader>

            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="DashboardItem" Content="Panel" Icon="Home" Tag="dashboard" />
                <NavigationViewItem Content="Herramientas" Icon="Setting" Tag="tools" />
                <NavigationViewItem Content="Historial" Icon="Clock" Tag="history" />
                <NavigationViewItem Content="Recargar app" Icon="Refresh" SelectsOnInvoked="False" Tag="reload" />
            </NavigationView.MenuItems>

            <Frame x:Name="ContentFrame" Margin="0,0,8,8" />
        </NavigationView>
    </Grid>
</Window>
