<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="MediaWorkflowOrchestrator.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid x:Name="RootShell" Background="{StaticResource WindowBackdropBrush}" Loaded="OnRootShellLoaded">
        <NavigationView
            x:Name="AppNavigationView"
            Background="Transparent"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            CompactPaneLength="56"
            CompactModeThresholdWidth="860"
            ExpandedModeThresholdWidth="1320"
            OpenPaneLength="296"
            PaneDisplayMode="Auto"
            DisplayModeChanged="OnNavigationDisplayModeChanged"
            PaneOpening="OnNavigationPaneOpening"
            PaneClosing="OnNavigationPaneClosing"
            PaneOpened="OnNavigationPaneVisibilityChanged"
            PaneClosed="OnNavigationPaneVisibilityChanged"
            ItemInvoked="OnNavigationItemInvoked"
            SelectionChanged="OnNavigationSelectionChanged">
            <NavigationView.Header>
                <StackPanel Spacing="2">
                    <TextBlock Style="{StaticResource HeroTitleTextStyle}" Text="{x:Bind ViewModel.WindowTitle, Mode=OneWay}" />
                    <TextBlock Style="{StaticResource MutedCaptionTextStyle}" Text="Orquesta descargas, inspección, traducción, limpieza y empaquetado desde una sola ventana." />
                </StackPanel>
            </NavigationView.Header>
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="DashboardItem" Content="Dashboard" Icon="Home" Tag="dashboard" />
                <NavigationViewItem Content="Herramientas" Icon="Setting" Tag="tools" />
                <NavigationViewItem Content="Historial" Icon="Clock" Tag="history" />
                <NavigationViewItem Content="Reload" Icon="Refresh" SelectsOnInvoked="False" Tag="reload" />
            </NavigationView.MenuItems>
            <NavigationView.PaneCustomContent>
                <ScrollViewer
                    x:Name="QuickActionsPaneScrollViewer"
                    Margin="6,3,6,6"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto"
                    VerticalScrollMode="Auto">
                    <Grid>
                        <StackPanel x:Name="QuickActionsExpandedRoot" Spacing="6">
                            <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="Inicio rápido" />

                            <Border Padding="6" Background="{StaticResource PaneGlassBrush}" BorderBrush="{StaticResource OverlayStrokeBrush}" BorderThickness="1" CornerRadius="14">
                                <StackPanel Spacing="4">
                                    <TextBlock Style="{StaticResource MutedCaptionTextStyle}" Text="Cargar o descargar" />
                                    <Button Click="OnQuickPickFileClicked" HorizontalAlignment="Stretch" Style="{StaticResource DenseActionButtonStyle}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <SymbolIcon Symbol="Document" />
                                            <TextBlock Text="Elegir archivo base" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Button>
                                    <Button Click="OnQuickPickFolderClicked" HorizontalAlignment="Stretch" Style="{StaticResource DenseActionButtonStyle}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <SymbolIcon Symbol="Folder" />
                                            <TextBlock Text="Elegir carpeta del release" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Button>
                                    <Button Click="OnQuickDownloadWeeklyClicked" HorizontalAlignment="Stretch" Style="{StaticResource DenseActionButtonStyle}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <SymbolIcon Symbol="Download" />
                                            <TextBlock Text="Descarga semanal desde Nyaa" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Button>
                                    <Button Click="OnQuickDownloadFromLinkClicked" HorizontalAlignment="Stretch" Style="{StaticResource DenseActionButtonStyle}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <SymbolIcon Symbol="World" />
                                            <TextBlock Text="Descargar desde link de Nyaa" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <Border Padding="6" Background="{StaticResource PaneGlassBrush}" BorderBrush="{StaticResource OverlayStrokeBrush}" BorderThickness="1" CornerRadius="14">
                                <StackPanel Spacing="4">
                                    <TextBlock Style="{StaticResource MutedCaptionTextStyle}" Text="Acciones del flujo" />
                                    <Button Click="OnQuickRunNextClicked" HorizontalAlignment="Stretch" Style="{StaticResource PrimaryCommandButtonStyle}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <SymbolIcon Symbol="Play" />
                                            <TextBlock Text="Ejecutar siguiente paso" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="QuickRunSelectedButton" Click="OnQuickRunSelectedClicked" HorizontalAlignment="Stretch" Style="{StaticResource DenseActionButtonStyle}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <SymbolIcon Symbol="Forward" />
                                            <TextBlock Text="Ejecutar paso seleccionado" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Button>
                                    <Button Click="OnQuickRetryClicked" HorizontalAlignment="Stretch" Style="{StaticResource DenseActionButtonStyle}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <SymbolIcon Symbol="Refresh" />
                                            <TextBlock Text="Reintentar paso" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Button>
                                    <Button Click="OnQuickSkipClicked" HorizontalAlignment="Stretch" Style="{StaticResource DenseActionButtonStyle}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <SymbolIcon Symbol="Redo" />
                                            <TextBlock Text="Omitir paso seleccionado" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Button>
                                    <Button Click="OnQuickCancelClicked" HorizontalAlignment="Stretch" Style="{StaticResource DenseActionButtonStyle}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <SymbolIcon Symbol="Cancel" />
                                            <TextBlock Text="Cancelar ejecución actual" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <Border Padding="6" Background="{StaticResource PaneGlassBrush}" BorderBrush="{StaticResource OverlayStrokeBrush}" BorderThickness="1" CornerRadius="14">
                                <StackPanel Spacing="4">
                                    <TextBlock Style="{StaticResource MutedCaptionTextStyle}" Text="Revisión y salida" />
                                    <Button Click="OnQuickOpenFolderClicked" HorizontalAlignment="Stretch" Style="{StaticResource DenseActionButtonStyle}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <SymbolIcon Symbol="OpenFile" />
                                            <TextBlock Text="Abrir carpeta del workflow" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Button>
                                    <Button Click="OnQuickOpenLogClicked" HorizontalAlignment="Stretch" Style="{StaticResource DenseActionButtonStyle}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <SymbolIcon Symbol="Page" />
                                            <TextBlock Text="Abrir log del paso" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel x:Name="QuickActionsCompactRoot" Spacing="8" HorizontalAlignment="Center" Visibility="Collapsed">
                            <Button Click="OnQuickPickFileClicked" Width="36" Height="36" MinWidth="36" Padding="0" HorizontalAlignment="Left" ToolTipService.ToolTip="Elegir archivo base">
                                <SymbolIcon Symbol="Document" />
                            </Button>
                            <Button Click="OnQuickPickFolderClicked" Width="36" Height="36" MinWidth="36" Padding="0" HorizontalAlignment="Left" ToolTipService.ToolTip="Elegir carpeta del release">
                                <SymbolIcon Symbol="Folder" />
                            </Button>
                            <Button Click="OnQuickDownloadWeeklyClicked" Width="36" Height="36" MinWidth="36" Padding="0" HorizontalAlignment="Left" ToolTipService.ToolTip="Descarga semanal desde Nyaa">
                                <SymbolIcon Symbol="Download" />
                            </Button>
                            <Button Click="OnQuickDownloadFromLinkClicked" Width="36" Height="36" MinWidth="36" Padding="0" HorizontalAlignment="Left" ToolTipService.ToolTip="Descargar desde link de Nyaa">
                                <SymbolIcon Symbol="World" />
                            </Button>
                            <Button Click="OnQuickRunNextClicked" Width="36" Height="36" MinWidth="36" Padding="0" HorizontalAlignment="Left" ToolTipService.ToolTip="Ejecutar siguiente paso">
                                <SymbolIcon Symbol="Play" />
                            </Button>
                            <Button x:Name="CompactQuickRunSelectedButton" Click="OnQuickRunSelectedClicked" Width="36" Height="36" MinWidth="36" Padding="0" HorizontalAlignment="Left" ToolTipService.ToolTip="Ejecutar paso seleccionado">
                                <SymbolIcon Symbol="Forward" />
                            </Button>
                            <Button Click="OnQuickRetryClicked" Width="36" Height="36" MinWidth="36" Padding="0" HorizontalAlignment="Left" ToolTipService.ToolTip="Reintentar paso">
                                <SymbolIcon Symbol="Refresh" />
                            </Button>
                            <Button Click="OnQuickSkipClicked" Width="36" Height="36" MinWidth="36" Padding="0" HorizontalAlignment="Left" ToolTipService.ToolTip="Omitir paso seleccionado">
                                <SymbolIcon Symbol="Redo" />
                            </Button>
                            <Button Click="OnQuickCancelClicked" Width="36" Height="36" MinWidth="36" Padding="0" HorizontalAlignment="Left" ToolTipService.ToolTip="Cancelar ejecución actual">
                                <SymbolIcon Symbol="Cancel" />
                            </Button>
                            <Button Click="OnQuickOpenFolderClicked" Width="36" Height="36" MinWidth="36" Padding="0" HorizontalAlignment="Left" ToolTipService.ToolTip="Abrir carpeta del workflow">
                                <SymbolIcon Symbol="OpenFile" />
                            </Button>
                            <Button Click="OnQuickOpenLogClicked" Width="36" Height="36" MinWidth="36" Padding="0" HorizontalAlignment="Left" ToolTipService.ToolTip="Abrir log del paso">
                                <SymbolIcon Symbol="Page" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </NavigationView.PaneCustomContent>
            <Frame x:Name="ContentFrame" />
        </NavigationView>
    </Grid>
</Window>
