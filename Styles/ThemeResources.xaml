    <Style x:Key="DashboardStatusValueTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="WrapWholeWords" />
    </Style>

    <Style x:Key="TableHeaderTextStyle" TargetType="TextBlock" BasedOn="{StaticResource SectionTitleTextStyle}">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="CharacterSpacing" Value="60" />
    </Style>

    <Style x:Key="RailMetricLabelTextStyle" TargetType="TextBlock" BasedOn="{StaticResource MutedCaptionTextStyle}">
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style x:Key="RailMetricValueTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="WrapWholeWords" />
