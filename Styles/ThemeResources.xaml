    <SolidColorBrush x:Key="TextTertiaryBrush" Color="{ThemeResource TextTertiaryColor}" />
    <SolidColorBrush x:Key="SurfaceMutedBrush" Color="{ThemeResource InsetSurfaceColor}" />
    <SolidColorBrush x:Key="CardGlassBrush" Color="{ThemeResource CardSurfaceColor}" />
    <SolidColorBrush x:Key="CardGlassStrongBrush" Color="{ThemeResource CardSurfaceStrongColor}" />
