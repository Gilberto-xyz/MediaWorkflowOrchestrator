    <Style x:Key="CleanTracksToggleButtonStyle" TargetType="ToggleButton" BasedOn="{StaticResource QuickToggleButtonStyle}">
        <Setter Property="Padding" Value="12,7" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Background" Value="#3321184E" />
        <Setter Property="BorderBrush" Value="#7A5B4BE0" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
    </Style>

    <Style x:Key="DashboardSectionHeadingTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="19" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="0" />
        <Setter Property="TextWrapping" Value="WrapWholeWords" />
