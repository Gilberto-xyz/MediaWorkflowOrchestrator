    <LinearGradientBrush x:Key="WindowBackdropBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{ThemeResource WindowBackdropStartColor}" Offset="0" />
        <GradientStop Color="{ThemeResource WindowBackdropMidColor}" Offset="0.52" />
        <GradientStop Color="{ThemeResource WindowBackdropEndColor}" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="CinematicVeilBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{ThemeResource HeroVeilStartColor}" Offset="0" />
        <GradientStop Color="#00000000" Offset="0.4" />
        <GradientStop Color="{ThemeResource HeroVeilEndColor}" Offset="1" />
    </LinearGradientBrush>

    <RadialGradientBrush x:Key="MatrixGlowBrush" RadiusX="0.76" RadiusY="0.76">
        <GradientStop Color="{ThemeResource BackdropGlowColor}" Offset="0" />
        <GradientStop Color="#12E5A34F" Offset="0.58" />
        <GradientStop Color="#00000000" Offset="1" />
    </RadialGradientBrush>

    <RadialGradientBrush x:Key="AnimeGlowBrush" RadiusX="0.72" RadiusY="0.72">
        <GradientStop Color="#38F0C56A" Offset="0" />
        <GradientStop Color="#10F0C56A" Offset="0.62" />
        <GradientStop Color="#00000000" Offset="1" />
    </RadialGradientBrush>

    <RadialGradientBrush x:Key="CinemaGlowBrush" RadiusX="0.82" RadiusY="0.82">
        <GradientStop Color="#2EDB8B39" Offset="0" />
        <GradientStop Color="#10DB8B39" Offset="0.62" />
        <GradientStop Color="#00000000" Offset="1" />
    </RadialGradientBrush>

    <LinearGradientBrush x:Key="SweepAccentBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{ThemeResource AccentSweepStartColor}" Offset="0" />
        <GradientStop Color="{ThemeResource AccentSweepMidColor}" Offset="0.52" />
        <GradientStop Color="{ThemeResource AccentSweepEndColor}" Offset="1" />
    </LinearGradientBrush>

    <Style x:Key="HeroTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="0" />
        <Setter Property="TextWrapping" Value="WrapWholeWords" />
    </Style>

    <Style x:Key="PageHeadlineTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="0" />
        <Setter Property="TextWrapping" Value="WrapWholeWords" />
    </Style>

    <Style x:Key="MetricValueTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="WrapWholeWords" />
    </Style>

    <Style x:Key="SectionTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="80" />
        <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="WrapWholeWords" />
    </Style>

    <Style x:Key="SectionDescriptionTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="WrapWholeWords" />
    </Style>

    <Style x:Key="HeaderInsightTextStyle" TargetType="TextBlock" BasedOn="{StaticResource SectionDescriptionTextStyle}">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="0" />
        <Setter Property="LineHeight" Value="23" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
    </Style>

    <Style x:Key="MutedCaptionTextStyle" TargetType="TextBlock">
        <Setter Property="Opacity" Value="0.94" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="WrapWholeWords" />
    </Style>

    <Style x:Key="MonoCaptionTextStyle" TargetType="TextBlock" BasedOn="{StaticResource MutedCaptionTextStyle}">
        <Setter Property="FontFamily" Value="Consolas" />
        <Setter Property="CharacterSpacing" Value="12" />
    </Style>

    <Style x:Key="CardContainerStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="10" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style x:Key="InsetPanelBorderStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="Background" Value="{ThemeResource DashboardPanelBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource HairlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="AccentPanelBorderStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="Background" Value="{ThemeResource DashboardPanelBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource OverlayStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="PaneSectionBorderStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="10" />
        <Setter Property="Background" Value="{ThemeResource PaneGlassBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource HairlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="DenseActionButtonStyle" TargetType="Button">
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="{ThemeResource DashboardChipBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource HairlineBrush}" />
    </Style>

    <Style x:Key="PrimaryCommandButtonStyle" TargetType="Button">
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="{ThemeResource AccentPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource AccentPrimaryBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource AccentForegroundBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="ColoredCommandAppBarButtonStyle" TargetType="AppBarButton">
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Margin" Value="2,0" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="QuickToggleButtonStyle" TargetType="ToggleButton">
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="{ThemeResource DashboardChipBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource HairlineBrush}" />
